# Normalise line endings: LF in the repository, native in the working tree.
# Without this, Git warns on every file committed from Windows.
* text=auto eol=lf

# Binary assets must never be normalised.
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary

# Keep lockfile diffs collapsed in reviews.
package-lock.json linguist-generated=true -diff
